@model AppTask.Models.CentralCusto

@{
    ViewData["Title"] = "Nova Central de Custo";
}

<h1 class="mb-4">Cadastrar Nova Central de Custo</h1>

<div class="row">
    <div class="col-md-6">

        <form action="/CentralCusto/Create" method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="NomeCusto" class="form-label">
                    Nome do Custo
                </label>

                <input type="text"
                       id="NomeCusto"
                       name="NomeCusto"
                       class="form-control"
                       placeholder="Digite o nome do custo"
                       required />
            </div>

            <div class="mb-3">
                <label for="ValorAnualMeta" class="form-label">
                    Valor Anual da Meta
                </label>

                <input type="number"
                       id="ValorAnualMeta"
                       name="ValorAnualMeta"
                       class="form-control"
                       placeholder="Digite o valor anual"
                       step="0.01"
                       required />
            </div>

            <div class="mb-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Salvar Central de Custo
                </button>

                <a href="/CentralCusto/Index"
                   class="btn btn-secondary">
                    Voltar para a Lista
                </a>

            </div>

        </form>

    </div>
</div>
