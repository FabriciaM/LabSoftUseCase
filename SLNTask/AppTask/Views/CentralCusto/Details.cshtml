@model AppTask.Models.CentralCusto
@{
    ViewData["Title"] = "Detalhes da central de custos";
}
<div class="detail-page-header"><div><div class="eyebrow">Financeiro</div><h1>Detalhes da central de custos</h1><p>Visualize as informações financeiras cadastradas.</p></div><div class="detail-actions"><a asp-action="Edit" asp-route-id="@Model.Codigo" class="primary-btn">Editar central</a><a asp-action="Index" class="secondary-btn">← Voltar</a></div></div>
<div class="detail-card"><div class="profile-heading"><span class="profile-avatar money-symbol">R$</span><div><span class="detail-label">Central de custos</span><h2>@Model.NomeCusto</h2></div></div><div class="detail-grid"><div><span class="detail-label">Nome do custo</span><strong>@Model.NomeCusto</strong></div><div><span class="detail-label">Valor anual da meta</span><strong class="money-value">@Model.ValorAnualMeta.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</strong></div></div></div>
