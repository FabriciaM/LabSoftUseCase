@model IEnumerable<AppTask.Models.CentralCusto>

@{
    ViewData["Title"] = "Central de custos";
}
<div class="list-page-header"><div><div class="eyebrow">Financeiro</div><h1>Central de custos</h1><p>Acompanhe as metas e informações de custos cadastradas.</p></div><a asp-action="Create" class="primary-btn"><span class="plus">＋</span> Nova central</a></div>
<div class="list-card">
    <div class="list-card-top"><h2>Lista de centrais de custo</h2><span class="record-count">@Model.Count() registros</span></div><div class="table-scroll">
        <table class="data-table">
            <thead><tr><th>Nome do custo</th><th>Valor anual da meta</th><th>Ações</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="3" class="empty-state">Nenhuma central de custo cadastrada.</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr><td class="strong-cell">@item.NomeCusto</td><td class="money-cell">@item.ValorAnualMeta.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td><td class="action-cell"><a asp-action="Edit" asp-route-id="@item.Codigo" class="table-action edit">Editar</a><a asp-action="Details" asp-route-id="@item.Codigo" class="table-action view">Detalhes</a><button type="button" class="table-action delete" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Codigo" data-descricao="@item.NomeCusto">Excluir</button></td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header bg-danger text-white"><h5 class="modal-title">Confirmar exclusão</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Deseja realmente excluir a central de custo <strong id="itemDescricao"></strong>?</div><div class="modal-footer"><button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancelar</button><form id="deleteForm" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Sim, excluir</button></form></div></div></div></div>
@section Scripts {
    <script>document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) { const b = event.relatedTarget; document.getElementById('itemDescricao').textContent = b.dataset.descricao; document.getElementById('deleteForm').action = '/CentralCusto/Delete/' + b.dataset.id; });</script>
}
