@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Novo departamento";
}
<div class="form-page-header"><div><div class="eyebrow">Cadastros</div><h1>Novo departamento</h1><p>Cadastre uma nova área para organizar a operação.</p></div><a asp-action="Index" class="secondary-btn">← Voltar para a lista</a></div>
<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-grid">
            <div class="form-field"><label asp-for="Descricao">Descrição</label><input asp-for="Descricao" class="form-control" placeholder="Digite o nome do departamento" autocomplete="off" /><span asp-validation-for="Descricao" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Ativo">Status</label><select asp-for="Ativo" class="form-select"><option value="">Selecione o status</option><option value="Sim">Ativo</option><option value="Não">Inativo</option></select><span asp-validation-for="Ativo" class="field-error"></span></div>
        </div><div class="form-actions"><button type="submit" class="primary-btn">Salvar departamento</button><a asp-action="Index" class="secondary-btn">Cancelar</a></div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
