@model AppTask.Models.Departamento

@{
    ViewData["Title"] = "Novo Departamento";
}

<h1 class="mb-4">Cadastrar Novo Departamento</h1>

<div class="row">
    <div class="col-md-6">

        <form action="/Departamento/Create" method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label for="Descricao" class="form-label">
                    Descrição
                </label>

                <input type="text"
                       id="Descricao"
                       name="Descricao"
                       class="form-control"
                       placeholder="Digite a descrição do departamento"
                       required />
            </div>

            <div class="mb-3">
                <label for="Ativo" class="form-label">
                    Ativo
                </label>

                <input type="text"
                       id="Ativo"
                       name="Ativo"
                       class="form-control"
                       placeholder="Digite o status"
                       required />
            </div>

            <div class="mb-3 d-flex gap-2">

                <button type="submit"
                        class="btn btn-primary">
                    Salvar Departamento
                </button>

                <a href="/Departamento/Index"
                   class="btn btn-secondary">
                    Voltar para a Lista
                </a>

            </div>

        </form>

    </div>
</div>
