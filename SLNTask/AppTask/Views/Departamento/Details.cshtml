@model AppTask.Models.Departamento
@{
    ViewData["Title"] = "Detalhes do departamento"; var ativo = Model.Ativo ?? "Não"; var classe = ativo.ToLower() == "sim" ? "status-done" : "status-open";
}
<div class="detail-page-header"><div><div class="eyebrow">Cadastros</div><h1>Detalhes do departamento</h1><p>Visualize as informações da área cadastrada.</p></div><div class="detail-actions"><a asp-action="Edit" asp-route-id="@Model.Codigo" class="primary-btn">Editar departamento</a><a asp-action="Index" class="secondary-btn">← Voltar</a></div></div>
<div class="detail-card"><div class="profile-heading"><span class="profile-avatar">@Model.Descricao.Substring(0, 1).ToUpper()</span><div><span class="detail-label">Departamento</span><h2>@Model.Descricao</h2></div><span class="status @classe">@ativo</span></div><div class="detail-grid"><div><span class="detail-label">Descrição</span><strong>@Model.Descricao</strong></div><div><span class="detail-label">Status</span><strong>@ativo</strong></div></div></div>
