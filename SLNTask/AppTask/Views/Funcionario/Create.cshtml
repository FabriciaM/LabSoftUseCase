@model AppTask.Models.Funcionario

@{
    ViewData["Title"] = "Novo funcionário";
}
<div class="form-page-header"><div><div class="eyebrow">Cadastros</div><h1>Novo funcionário</h1><p>Adicione um funcionário para atribuir tarefas no sistema.</p></div><a asp-action="Index" class="secondary-btn">← Voltar para a lista</a></div>
<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-grid">
            <div class="form-field"><label asp-for="Nome">Nome completo</label><input asp-for="Nome" class="form-control" placeholder="Digite o nome do funcionário" autocomplete="off" /><span asp-validation-for="Nome" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Cargo">Cargo</label><input asp-for="Cargo" class="form-control" placeholder="Digite o cargo do funcionário" autocomplete="off" /><span asp-validation-for="Cargo" class="field-error"></span></div>

            <div class="form-field"><label asp-for="CodigoGerente">Gerente <small>(opcional)</small></label><select asp-for="CodigoGerente" class="form-select" asp-items="ViewBag.ListaGerentes"><option value="">Selecione um gerente</option></select><span asp-validation-for="CodigoGerente" class="field-error"></span></div>

        </div><div class="form-actions"><button type="submit" class="primary-btn">Salvar funcionário</button><a asp-action="Index" class="secondary-btn">Cancelar</a></div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
