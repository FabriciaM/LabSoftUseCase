@model AppTask.Models.Funcionario
@{
    ViewData["Title"] = "Editar funcionário";
}
<div class="form-page-header"><div><div class="eyebrow">Cadastros</div><h1>Editar funcionário</h1><p>Atualize os dados do funcionário selecionado.</p></div><a asp-action="Index" class="secondary-btn">← Voltar para a lista</a></div>
<div class="form-card"><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Codigo" /><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-grid"><div class="form-field"><label asp-for="Nome">Nome completo</label><input asp-for="Nome" class="form-control" /><span asp-validation-for="Nome" class="field-error"></span></div><div class="form-field"><label asp-for="Cargo">Cargo</label><input asp-for="Cargo" class="form-control" /><span asp-validation-for="Cargo" class="field-error"></span></div></div><div class="form-actions"><button type="submit" class="primary-btn">Salvar alterações</button><a asp-action="Index" class="secondary-btn">Cancelar</a></div></form></div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
