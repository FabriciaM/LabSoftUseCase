@model IEnumerable<AppTask.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
}

<div class="list-page-header">
    <div>
        <div class="eyebrow">Cadastros</div>
        <h1>Funcionários</h1>
        <p>Gerencie os funcionários responsáveis pelas tarefas.</p>
    </div>
    <a asp-action="Create" class="primary-btn">
        <span class="plus">＋</span> Novo funcionário
    </a>
</div>

<div class="list-card">
    <div class="list-card-top">
        <h2>Lista de funcionários</h2>
        <span class="record-count">@Model.Count() registros</span>
    </div>

    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Cargo</th>
                    <th>Gerente</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="empty-state">Nenhum funcionário cadastrado.</td>
                    </tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="strong-cell">@item.Nome</td>
                            <td>@item.Cargo</td>
                            <td>@(item.Gerente?.Nome ?? "Sem gerente")</td>
                            <td class="action-cell">
                                <a asp-action="Edit" asp-route-id="@item.Codigo" class="table-action edit">Editar</a>
                                <a asp-action="Details" asp-route-id="@item.Codigo" class="table-action view">Detalhes</a>
                                <button type="button"
                                        class="table-action delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteModal"
                                        data-id="@item.Codigo"
                                        data-descricao="@item.Nome">
                                    Excluir
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar exclusão</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                Deseja realmente excluir o funcionário <strong id="itemDescricao"></strong>?
            </div>
            <div class="modal-footer">
                <button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancelar</button>
                <form id="deleteForm" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Sim, excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('itemDescricao').textContent = button.dataset.descricao;
            document.getElementById('deleteForm').action = '/Funcionario/Delete/' + button.dataset.id;
        });
    </script>
}
