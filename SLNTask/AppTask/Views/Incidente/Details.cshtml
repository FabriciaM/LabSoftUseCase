@model AppTask.Models.Incidente
@{
    ViewData["Title"] = "Detalhes do incidente"; var resolvido = Model.Resolvido ?? "Não"; var classe = resolvido.ToLower() == "sim" ? "status-done" : "status-progress";
}
<div class="detail-page-header"><div><div class="eyebrow">Monitoramento</div><h1>Detalhes do incidente</h1><p>Visualize o histórico e a situação do incidente.</p></div><div class="detail-actions"><a asp-action="Edit" asp-route-id="@Model.Codigo" class="primary-btn">Editar incidente</a><a asp-action="Index" class="secondary-btn">← Voltar</a></div></div>
<div class="detail-card"><div class="detail-card-title"><div><span class="detail-label">Descrição do problema</span><h2>@Model.DescricaoProblema</h2></div><span class="status @classe">@resolvido</span></div><div class="detail-grid"><div><span class="detail-label">Data do incidente</span><strong>@Model.DataIncidente.ToString("dd/MM/yyyy HH:mm")</strong></div><div class="detail-wide"><span class="detail-label">Solução</span><strong>@(Model.Solucao ?? "Ainda não informada")</strong></div></div></div>
