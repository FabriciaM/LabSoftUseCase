@model AppTask.Models.Incidente
@{
    ViewData["Title"] = "Editar incidente";
}
<div class="form-page-header"><div><div class="eyebrow">Monitoramento</div><h1>Editar incidente</h1><p>Atualize a descrição, solução e situação do incidente.</p></div><a asp-action="Index" class="secondary-btn">← Voltar para a lista</a></div>
<div class="form-card"><form asp-action="Edit" method="post">@Html.AntiForgeryToken()<input type="hidden" asp-for="Codigo" /><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-grid"><div class="form-field form-field-wide"><label asp-for="DescricaoProblema">Descrição do problema</label><input asp-for="DescricaoProblema" class="form-control" /><span asp-validation-for="DescricaoProblema" class="field-error"></span></div><div class="form-field"><label asp-for="DataIncidente">Data do incidente</label><input asp-for="DataIncidente" type="datetime-local" class="form-control" /><span asp-validation-for="DataIncidente" class="field-error"></span></div><div class="form-field"><label asp-for="Resolvido">Resolvido?</label><select asp-for="Resolvido" class="form-select"><option value="Não">Não</option><option value="Sim">Sim</option></select><span asp-validation-for="Resolvido" class="field-error"></span></div><div class="form-field form-field-wide"><label asp-for="Solucao">Solução</label><textarea asp-for="Solucao" class="form-control" rows="3"></textarea><span asp-validation-for="Solucao" class="field-error"></span></div></div><div class="form-actions"><button type="submit" class="primary-btn">Salvar alterações</button><a asp-action="Index" class="secondary-btn">Cancelar</a></div></form></div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
