@model IEnumerable<AppTask.Models.Incidente>

@{
    ViewData["Title"] = "Incidentes";
}
<div class="list-page-header"><div><div class="eyebrow">Monitoramento</div><h1>Incidentes</h1><p>Registre e acompanhe os problemas identificados.</p></div><a asp-action="Create" class="primary-btn"><span class="plus">＋</span> Novo incidente</a></div>
<div class="list-card">
    <div class="list-card-top"><h2>Lista de incidentes</h2><span class="record-count">@Model.Count() registros</span></div><div class="table-scroll">
        <table class="data-table">
            <thead><tr><th>Descrição do problema</th><th>Data</th><th>Solução</th><th>Resolvido</th><th>Ações</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="empty-state">Nenhum incidente cadastrado.</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var resolvido = item.Resolvido ?? "Não"; var classe = resolvido.ToLower() == "sim" ? "status-done" : "status-progress";
                        <tr><td class="strong-cell">@item.DescricaoProblema</td><td>@item.DataIncidente.ToString("dd/MM/yyyy HH:mm")</td><td>@(item.Solucao ?? "Ainda não informado")</td><td><span class="status @classe">@resolvido</span></td><td class="action-cell"><a asp-action="Edit" asp-route-id="@item.Codigo" class="table-action edit">Editar</a><a asp-action="Details" asp-route-id="@item.Codigo" class="table-action view">Detalhes</a><button type="button" class="table-action delete" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Codigo" data-descricao="@item.DescricaoProblema">Excluir</button></td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header bg-danger text-white"><h5 class="modal-title">Confirmar exclusão</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Deseja realmente excluir o incidente <strong id="itemDescricao"></strong>?</div><div class="modal-footer"><button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancelar</button><form id="deleteForm" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Sim, excluir</button></form></div></div></div></div>
@section Scripts {
    <script>document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) { const b = event.relatedTarget; document.getElementById('itemDescricao').textContent = b.dataset.descricao; document.getElementById('deleteForm').action = '/Incidente/Delete/' + b.dataset.id; });</script>
}
