@model AppTask.Models.Tarefa
@{
    ViewData["Title"] = "Editar tarefa";
}
<div class="form-page-header"><div><div class="eyebrow">Gestão</div><h1>Editar tarefa</h1><p>Atualize as informações e o andamento desta tarefa.</p></div><a asp-action="Index" class="secondary-btn">← Voltar para a lista</a></div>
<div class="form-card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()<input type="hidden" asp-for="Codigo" /><div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div><div class="form-grid">
            <div class="form-field form-field-wide"><label asp-for="Descricao">Descrição</label><input asp-for="Descricao" class="form-control" /><span asp-validation-for="Descricao" class="field-error"></span></div>
            <div class="form-field"><label asp-for="DataPlanejada">Data planejada</label><input asp-for="DataPlanejada" type="datetime-local" class="form-control" /><span asp-validation-for="DataPlanejada" class="field-error"></span></div>
            <div class="form-field"><label asp-for="FuncionarioId">Funcionário responsável</label><select asp-for="FuncionarioId" class="form-select" asp-items="ViewBag.FuncionarioId"></select><span asp-validation-for="FuncionarioId" class="field-error"></span></div>
            <div class="form-field"><label asp-for="StatusTarefa">Status da tarefa</label><select asp-for="StatusTarefa" class="form-select"><option value="Pendente">Pendente</option><option value="Em Andamento">Em Andamento</option><option value="Concluído">Concluído</option><option value="Cancelado">Cancelado</option></select><span asp-validation-for="StatusTarefa" class="field-error"></span></div>
            <div class="form-field"><label asp-for="Prazo">Prazo</label><input asp-for="Prazo" class="form-control" /><span asp-validation-for="Prazo" class="field-error"></span></div>
            <div class="form-field"><label asp-for="DataIniciada">Data iniciada</label><input asp-for="DataIniciada" type="datetime-local" class="form-control" /><span asp-validation-for="DataIniciada" class="field-error"></span></div>
            <div class="form-field"><label asp-for="DataFinalizada">Data finalizada</label><input asp-for="DataFinalizada" type="datetime-local" class="form-control" /><span asp-validation-for="DataFinalizada" class="field-error"></span></div>
            <div class="form-field"><label asp-for="DataCancelada">Data cancelada</label><input asp-for="DataCancelada" type="datetime-local" class="form-control" /><span asp-validation-for="DataCancelada" class="field-error"></span></div>
        </div><div class="form-actions"><button type="submit" class="primary-btn">Salvar alterações</button><a asp-action="Index" class="secondary-btn">Cancelar</a></div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
