@model IEnumerable<AppTask.Models.Tarefa>

@{
    ViewData["Title"] = "Tarefas";
}

<div class="list-page-header">
    <div><div class="eyebrow">Gestão</div><h1>Tarefas</h1><p>Consulte e acompanhe as tarefas cadastradas no sistema.</p></div>
    <a asp-action="Create" class="primary-btn"><span class="plus">＋</span> Nova tarefa</a>
</div>
@if (TempData["MensagemSucesso"] is string mensagem)
{
    <div class="success-message" role="alert">✓ @mensagem</div>
}
<div class="list-card">
    <div class="list-card-top"><h2>Lista de tarefas</h2><span class="record-count">@Model.Count() registros</span></div>
    <div class="table-scroll">
        <table class="data-table">
            <thead><tr><th>Descrição</th><th>Data planejada</th><th>Status</th><th>Prazo</th><th>Funcionário</th><th>Ações</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="empty-state">Nenhuma tarefa cadastrada.</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        var status = item.StatusTarefa ?? "Sem status"; var classe = status.ToLower().Contains("conclu") ? "status-done" : status.ToLower().Contains("andamento") ? "status-progress" : "status-open";
                        <tr><td class="strong-cell">@item.Descricao</td><td>@item.DataPlanejada.ToString("dd/MM/yyyy HH:mm")</td><td><span class="status @classe">@status</span></td><td>@item.Prazo</td><td>@(item.Funcionario?.Nome ?? "Não informado")</td><td class="action-cell"><a asp-action="Edit" asp-route-id="@item.Codigo" class="table-action edit">Editar</a><a asp-action="Details" asp-route-id="@item.Codigo" class="table-action view">Detalhes</a><button type="button" class="table-action delete" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.Codigo" data-descricao="@item.Descricao">Excluir</button></td></tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog"><div class="modal-content"><div class="modal-header bg-danger text-white"><h5 class="modal-title">Confirmar exclusão</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">Deseja realmente excluir a tarefa <strong id="tarefaDescricao"></strong>?</div><div class="modal-footer"><button type="button" class="secondary-btn" data-bs-dismiss="modal">Cancelar</button><form id="deleteForm" method="post">@Html.AntiForgeryToken()<button type="submit" class="btn btn-danger">Sim, excluir</button></form></div></div></div></div>
@section Scripts {
    <script>document.getElementById('deleteModal').addEventListener('show.bs.modal', function (event) { const button = event.relatedTarget; document.getElementById('tarefaDescricao').textContent = button.dataset.descricao; document.getElementById('deleteForm').action = '/Tarefa/Delete/' + button.dataset.id; });</script>
}
