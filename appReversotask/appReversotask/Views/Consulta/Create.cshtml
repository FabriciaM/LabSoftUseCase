@model appReversotask.Models.Consulta

@{
    ViewData["Title"] = "Nova consulta";
}

<h1>Nova consulta</h1>

<h4>Consulta</h4>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="DataHora" class="control-label">
                    Data e hora
                </label>

                <input asp-for="DataHora"
                       class="form-control" />

                <span asp-validation-for="DataHora"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StatusConsulta"
                       class="control-label">
                    Status da consulta
                </label>

                <input asp-for="StatusConsulta"
                       class="form-control" />

                <span asp-validation-for="StatusConsulta"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">
                    Paciente
                </label>

                <input type="text"
                       class="form-control"
                       value="@ViewData["PacienteNome"]"
                       readonly />

                <input type="hidden"
                       asp-for="Pacienteid"
                       value="@ViewData["PacienteId"]" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Medicoid"
                       class="control-label">
                    Médico
                </label>

                <select asp-for="Medicoid"
                        class="form-control"
                        asp-items="ViewBag.Medicoid">
                    <option value="">Selecione o médico</option>
                </select>

                <span asp-validation-for="Medicoid"
                      class="text-danger"></span>
            </div>

            <div class="mt-3">
                <input type="submit"
                       value="Cadastrar"
                       class="btn btn-primary" />

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}
